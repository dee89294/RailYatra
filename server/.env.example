# ==============================================================================
# RailYatra Backend Environment Configuration
# Copy this file to `server/.env` and customize values for your environment.
# ==============================================================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Secret key for signing local session JWTs & verification tokens
# (Always replace with a strong 32+ character random string in production!)
JWT_SECRET=railyatra-dev-secret-change-in-production-2026

# ------------------------------------------------------------------------------
# Data & Auth Provider Mode: "auto" | "local" | "supabase"
# - "auto": Uses Supabase automatically if SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
#           are configured; otherwise runs seamlessly on local SQLite.
# ------------------------------------------------------------------------------
DATA_PROVIDER=auto

# Supabase Configuration (Optional for local dev; required for Supabase mode)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# SMTP Email Configuration (Nodemailer)
# Recommended in production (e.g., Gmail App Password, Brevo, Resend) so
# unlimited users can register & receive real email verification links in both
# Supabase and Local modes. Leave blank locally to use the Dev Email Outbox.
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RailYatra Support <no-reply@railyatra.in>"

# ------------------------------------------------------------------------------
# External Indian Railway Live Tracking API (Optional)
# Supports RailCore (`https://ir.railcore.tech`) or RapidAPI endpoints.
# When omitted, RailYatra uses a schedule-synchronized realistic live tracker.
# ------------------------------------------------------------------------------
RAILCORE_API_URL=https://ir.railcore.tech
RAILCORE_API_KEY=

RAILWAY_API_URL=
RAILWAY_API_KEY=
RAILWAY_API_HOST=
